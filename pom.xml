<!--                    <artifactId>log4j</artifactId>-->
<!--                </exclusion>-->
<!--            </exclusions>-->

<!--        </dependency>-->

<!--        <dependency>-->
<!--            <groupId>orj.slf4j</groupId>-->
<!--            <artifactId>slf4j-api</artifactId>-->
